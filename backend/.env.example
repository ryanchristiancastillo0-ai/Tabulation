# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── AI Provider 1: UnoRouter (default) ─────────────────────────────────────────
# OpenAI-compatible endpoint: https://api.unorouter.com/v1/chat/completions
# Models: codestral-latest, qwen3.8-flash, glm-5.3-flash, gemini-3.5-flash-lite, gpt-oss-20b
UNOROUTER_API_KEY=your_unorouter_api_key
# Optional per-provider request timeout (ms). Defaults to AI_JOB_TIMEOUT_MS.
# UNOROUTER_TIMEOUT_MS=240000

# ── AI Provider 2: Google Gemini ───────────────────────────────────────────────
# Official REST API: https://generativelanguage.googleapis.com/v1beta/...
# Models: gemini-3.1-flash-lite
GEMINI_API_KEY=your_gemini_api_key
# Optional per-provider request timeout (ms).
# GEMINI_TIMEOUT_MS=240000

# ── Shared AI request timeout (ms) ─────────────────────────────────────────────
# AI_JOB_TIMEOUT_MS=240000

# ── MySQL (existing) ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=tabulation_db
# Optional CA certificate for managed MySQL (multi-line PEM string, like your .env)
# DB_CA_CERT="-----BEGIN CERTIFICATE----- ... -----END CERTIFICATE-----"

# ── Email (existing) ──────────────────────────────────────────────────────────
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
RECEIVER_EMAIL=your_receiver@example.com

# ── JWT (existing) ────────────────────────────────────────────────────────────
# IMPORTANT: set a real, unique secret here (and in Render's dashboard).
JWT_SECRET=change_this_secret
# Session lifetime. Keep long enough to last a multi-day event (e.g. 7d / 30d).
JWT_EXPIRES=7d