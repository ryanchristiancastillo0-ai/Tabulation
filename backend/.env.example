# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── Gemini (existing LLM provider) ────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ── MySQL (existing) ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=tabulation_db
# Optional CA certificate for managed MySQL (multi-line PEM string, like your .env)
# DB_CA_CERT="-----BEGIN CERTIFICATE----- ... -----END CERTIFICATE-----"

# ── Email (existing) ──────────────────────────────────────────────────────────
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
RECEIVER_EMAIL=your_receiver@example.com

# ── Upstash Redis ─────────────────────────────────────────────────────────────
# Redis-compatible TCP URL used by the BullMQ AI generation queue + worker.
# Get this from Upstash Console → Database → Connect → redis-cli / TLS URL.
UPSTASH_REDIS_URL=redis://default:YOUR_TOKEN@YOUR_HOST-REGION.upstash.io:6379

# Upstash REST endpoint + token used for application caching (@upstash/redis).
UPSTASH_REDIS_REST_URL=https://YOUR_APP-REGION.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_REST_TOKEN

# ── AI queue / worker ─────────────────────────────────────────────────────────
# Max LLM jobs the worker processes at once (respect your Gemini rate limits).
AI_WORKER_CONCURRENCY=3
# Max wall-clock time for one LLM job before it is treated as timed out + retried (ms).
AI_JOB_TIMEOUT_MS=150000
# Max attempts for transient (retryable) failures.
AI_JOB_MAX_ATTEMPTS=3

# ── JWT (existing) ────────────────────────────────────────────────────────────
JWT_SECRET=change_this_secret
JWT_EXPIRES=8h