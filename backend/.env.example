# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── B.AI (LLM provider) ───────────────────────────────────────────────────────
# OpenAI-compatible chat-completions endpoint: https://api.b.ai/v1/chat/completions
# The Admin-selected model overrides BAI_MODEL for that generation request.
BAI_API_KEY=your_bai_api_key
BAI_MODEL=qwen3.8-flash

# ── OpenRouter (automatic B.AI fallback) ───────────────────────────────────────
# Used silently when B.AI fails — never selectable by the Admin in the UI.
# Free model: nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=your_openrouter_api_key

# ── MySQL (existing) ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=tabulation_db
# Optional CA certificate for managed MySQL (multi-line PEM string, like your .env)
# DB_CA_CERT="-----BEGIN CERTIFICATE----- ... -----END CERTIFICATE-----"

# ── Email (existing) ──────────────────────────────────────────────────────────
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
RECEIVER_EMAIL=your_receiver@example.com

# ── JWT (existing) ────────────────────────────────────────────────────────────
# IMPORTANT: set a real, unique secret here (and in Render's dashboard).
JWT_SECRET=change_this_secret
# Session lifetime. Keep long enough to last a multi-day event (e.g. 7d / 30d).
JWT_EXPIRES=7d