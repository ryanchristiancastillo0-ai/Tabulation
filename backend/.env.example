# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── AI Provider 1: Groq (default) ────────────────────────────────────────────
# OpenAI-compatible endpoint: https://api.groq.com/openai/v1/chat/completions
# Models: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.6-27b
GROQ_API_KEY=your_groq_api_key
# Optional per-provider request timeout (ms). Defaults to AI_JOB_TIMEOUT_MS.
# GROQ_TIMEOUT_MS=240000
# Optional default model override (defaults to openai/gpt-oss-120b).
# GROQ_MODEL=openai/gpt-oss-120b

# ── AI Provider 2: Google Gemini ───────────────────────────────────────────────
# Official REST API: https://generativelanguage.googleapis.com/v1beta/...
# Models: gemini-3.1-flash-lite
GEMINI_API_KEY=your_gemini_api_key
# Optional per-provider request timeout (ms).
# GEMINI_TIMEOUT_MS=240000
# Optional default model override (defaults to gemini-3.1-flash-lite).
# GEMINI_MODEL=gemini-3.1-flash-lite

# ── AI Provider 3: OpenRouter ──────────────────────────────────────────────────
# OpenAI-compatible free router: https://openrouter.ai/api/v1/chat/completions
# Model: openrouter/free (the FREE router — picks among OpenRouter's currently
# free models). See https://openrouter.ai/docs/guides/routing/routers/free-router
OPENROUTER_API_KEY=your_openrouter_api_key
# Optional per-provider request timeout (ms).
# OPENROUTER_TIMEOUT_MS=240000
# Optional default model override (defaults to openrouter/free).
# OPENROUTER_MODEL=openrouter/free

# ── Shared AI request timeout (ms) ─────────────────────────────────────────────
# AI_JOB_TIMEOUT_MS=240000

# ── MySQL (existing) ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=tabulation_db
# Optional CA certificate for managed MySQL (multi-line PEM string, like your .env)
# DB_CA_CERT="-----BEGIN CERTIFICATE----- ... -----END CERTIFICATE-----"

# ── Email (existing) ──────────────────────────────────────────────────────────
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
RECEIVER_EMAIL=your_receiver@example.com

# ── JWT (existing) ────────────────────────────────────────────────────────────
# IMPORTANT: set a real, unique secret here (and in Render's dashboard).
JWT_SECRET=change_this_secret
# Session lifetime. Keep long enough to last a multi-day event (e.g. 7d / 30d).
JWT_EXPIRES=7d